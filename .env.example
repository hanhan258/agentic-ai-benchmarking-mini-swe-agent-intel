# Intel PCM 版 Agent benchmark 配置模板
# 使用方法：cp .env.example .env，然后按实际环境修改。
# 显式 export 的环境变量优先于本文件；真实密钥禁止提交到 Git。

# Dashboard 监听端口。
AAB_UI_PORT=8080
# 历史变量名仍保留；这里填写 LiteLLM 或其他 OpenAI 兼容服务的 API 根地址。
VLLM_BASE_URL=http://127.0.0.1:4000/v1
# LiteLLM 中配置的模型名称；通过 LiteLLM 时通常使用实际 served model 名称。
MODEL=DeepSeek-V4-Flash
# 仅在本地 .env 中填写真实 LiteLLM key；不要提交或写入镜像。
OPENAI_API_KEY=

# Agent 数量/任务总量 sweep 的执行取值，空格分隔。
AGENT_SWEEP=1 2 4 8 16 32 64
# 发送给模型的上下文长度，单位为 token。
CONTEXT_LENGTH=4096
# 同时执行的 Agent 任务数；它不等于 AGENT_SWEEP 中的任务总量。
PARALLELISM=8
# Agent 适配器：cli 调用真实 mini-SWE-agent，mock 仅用于冒烟/单元测试。
ADAPTER_MODE=cli
# Agent Worker 运行方式：docker 或 process。
RUNTIME_TYPE=docker
# mini-SWE-agent 命令名或绝对路径。
MINI_COMMAND=mini

# 任务来源：local 使用本地仓库，synthetic 使用合成任务。
TASK_SOURCE=local
# local 模式下交给 Agent 的任务描述。
TASK=Inspect the repository and make a focused improvement.
# 任务完成后的验证命令；建议指向目标仓库的测试子集。
VERIFY_COMMAND=python -m pytest --collect-only -q

# 是否启用真实仓库上下文扫描：1 启用，0 禁用。
AAB_REPO_CONTEXT_ENABLED=1
# 被测代码仓库的绝对路径。
AAB_REPO_SOURCE=/home/user/repos/django
# 工作区策略：worktree、copy 或 source；并发修改建议使用 worktree。
AAB_REPO_WORKSPACE_MODE=worktree
# 是否把 Git 历史纳入上下文构建：1 启用，0 禁用。
AAB_REPO_CONTEXT_INCLUDE_GIT_HISTORY=1
# 是否在 Agent 调用前运行 pytest --collect-only：1 启用，0 禁用。
AAB_REPO_CONTEXT_PYTEST_COLLECT=1

# Intel PCM 内存带宽采集器绝对路径；仅适用于支持的 Intel CPU。
PCM_BIN=/opt/intel-pcm-current/build/bin/pcm-memory
# Intel PCM 采样周期，单位为秒。
PCM_INTERVAL_SEC=1
# Intel PCM 原始 CSV 文件名，写入每个 run 的 metrics 目录。
PCM_OUTPUT_FILE=intel_pcm_memory.csv
# DCGM 命令名；Intel 版在有 NVIDIA GPU 的主机上可采集GPU指标。
AAB_DCGMI_BIN=dcgmi
